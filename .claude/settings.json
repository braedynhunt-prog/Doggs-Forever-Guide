{
  "permissions": {
    "allow": [
      "Bash(git push *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python tooling/hook_check_guide.py",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
